{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layers-online",
  "main": "server/online-worker.js",
  "compatibility_date": "2026-10-30",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/signal/*"] },
  "vars": { "ALLOWED_ORIGINS": "" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "OnlineRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OnlineRoom"] }]
}
